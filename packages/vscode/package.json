{
    "name": "grex-vscode",
    "displayName": "g-rex",
    "description": "Syntax highlighting and live compiler diagnostics for g-rex (.grex).",
    "version": "0.0.1",
    "publisher": "B1j2754",
    "license": "Apache-2.0",
    "homepage": "https://github.com/B1j2754/g-rex#readme",
    "repository": {
        "type": "git",
        "url": "https://github.com/B1j2754/g-rex",
        "directory": "packages/vscode"
    },
    "bugs": {
        "url": "https://github.com/B1j2754/g-rex/issues"
    },
    "keywords": [
        "grex",
        "g-rex",
        "regex",
        "regular expression",
        "language"
    ],
    "categories": [
        "Programming Languages",
        "Linters"
    ],
    "engines": {
        "vscode": "^1.90.0"
    },
    "main": "./dist/extension.cjs",
    "activationEvents": [
        "onLanguage:grex"
    ],
    "contributes": {
        "languages": [
            {
                "id": "grex",
                "aliases": [
                    "g-rex"
                ],
                "extensions": [
                    ".grex"
                ],
                "filenamePatterns": [
                    "*.grex.txt"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "grex",
                "scopeName": "source.grex",
                "path": "./syntaxes/grex.tmLanguage.json"
            }
        ]
    },
    "dependencies": {
        "@g-rex/core": "workspace:*"
    },
    "devDependencies": {
        "@types/vscode": "^1.90.0",
        "@vscode/vsce": "^3.2.0"
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "build": "bun build ./src/extension.ts --outfile ./dist/extension.cjs --format cjs --target node --external vscode",
        "package": "bun run build && vsce package --no-dependencies",
        "test": "bun test"
    }
}
